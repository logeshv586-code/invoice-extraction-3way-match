TODAY=2026-10-01
BUYER_GSTIN=29AABCE1234F1Z5
CONFIDENCE_THRESHOLD=0.85

# Assessment/default database.
DB_BACKEND=sqlite
ERP_DB=samples/erp.db

# Optional PostgreSQL adapter. Only used when DB_BACKEND=postgres.
POSTGRES_DSN=postgresql://user:password@localhost:5432/invoice_demo

# Primary OCR. Text-native PDFs bypass OCR and use embedded text.
OCR_MODE=unlimited_ocr_http
OCR_MIN_TEXT_CHARS=60
UNLIMITED_OCR_URL=http://127.0.0.1:10000
UNLIMITED_OCR_MODEL=Unlimited-OCR
UNLIMITED_OCR_TIMEOUT_SECONDS=1200

# Local vision fallback: used only when visual OCR fails or returns unusable text.
# Load a vision-capable GGUF in LM Studio. A text-only T5/Qwen GGUF cannot read images.
LM_STUDIO_VISION_FALLBACK=true
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_VISION_MODEL=qwen3-vl-4b-instruct
LM_STUDIO_TIMEOUT_SECONDS=300

# Structuring mode:
# heuristic          -> zero LLM required after OCR
# openai_compatible  -> optional local/remote text model to turn OCR text into schema JSON
# For LM Studio, leave URL on localhost:1234/v1 and set the loaded model identifier.
STRUCTURING_MODE=heuristic
STRUCTURING_API_URL=http://127.0.0.1:1234/v1
STRUCTURING_API_KEY=
STRUCTURING_MODEL=qwen3-4b-instruct-2507
STRUCTURING_TIMEOUT_SECONDS=120

# Optional cost accounting for hosted structuring models. Local defaults to zero.
INPUT_COST_PER_1M=0
OUTPUT_COST_PER_1M=0

# The brief's configured buyer GSTIN appears checksum-inconsistent under the
# standard Mod-36 algorithm. Keep false for strict compliance; only set true if
# you explicitly document a fixture exception after inspecting supplied samples.
ALLOW_CONFIGURED_BUYER_CHECKSUM_EXCEPTION=false
